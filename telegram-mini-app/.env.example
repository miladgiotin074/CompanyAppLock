# Bot token from BotFather. Server-side only. Never prefix this with VITE_.
# Copy this file to .env and paste the token there. .env is gitignored.
# TELEGRAM_BOT_TOKEN=123456789:AA...
# The glass-button address is not stored here. bot.js reads the Web App URL
# from the bot's own menu button (BotFather → Menu Button) and appends the section path.

# Same owner list as backend (optional). Used for /port /unport /مدیریت in groups.
# ADMIN_TELEGRAM_ID=123456789

# Backend base for bot → API calls (bind group, managers). Default localhost.
# BACKEND_URL=http://127.0.0.1:3000

# Leave unset so the panel calls /api/v1 on the same origin.
# Vite proxies that path to http://127.0.0.1:3000, which is what you want
# behind a single ngrok tunnel. Set an absolute URL only to skip the proxy.
# VITE_API_BASE=http://localhost:3000/api/v1

# Auto-refresh interval for the device list (ms).
VITE_REFRESH_MS=15000

# Gate: the panel runs ONLY inside Telegram. Leave this false/unset in
# production so a plain browser gets a blocking "open inside Telegram" screen.
# Set it to true ONLY for local browser/UI development (it installs a dev mock).
# Opening the panel inside Telegram always works regardless of this flag.
VITE_ALLOW_OUTSIDE_TELEGRAM=false
