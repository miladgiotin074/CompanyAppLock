# ---- Server ----
PORT=3000
HOST=0.0.0.0

# Comma-separated allowed origins for the panel (use * only behind a private network).
CORS_ORIGIN=*

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/companyapplock

# ---- Firebase Cloud Messaging ----
# Path to the Firebase service-account JSON (downloaded from the Firebase console).
# Keep this file OUT of version control.
FIREBASE_CREDENTIALS=./firebase-service-account.json

# Topic that every device subscribes to; the periodic wake pulse is published here.
FCM_TOPIC=all-devices

# ---- Behavior ----
# Default heartbeat/wake interval in minutes (operator can change it from the panel).
DEFAULT_HEARTBEAT_MINUTES=5

# A device counts as "online" if it was seen within heartbeatMinutes * this multiplier.
ONLINE_GRACE_MULTIPLIER=2.5

# Default delay (minutes) before the Android client shows its stability notification.
DEFAULT_STABILITY_NOTIF_DELAY_MINUTES=10

# ---- Telegram Mini App ----
# Bot token (same one the mini app's bot.js uses). When set, EVERY panel route
# verifies the Mini App initData signature and rejects requests without a valid
# one (HTTP 401) — this is what enforces "panel only from inside Telegram".
# Leave empty ONLY for local dev (admin id is then read unverified, no 401).
TELEGRAM_BOT_TOKEN=

# Production only: start-prod.js sets this to telegram-mini-app/dist so the
# Mini App and /api/v1 share one HTTPS origin. Do not set it for local Vite.
# PANEL_DIST=

# Comma-separated Telegram user ids that own the whole panel (create/delete
# ports, settings, fleet wake). Port managers are assigned per-port in the
# Telegram group. Leave empty in lab so any verified Mini App user is owner.
# ADMIN_TELEGRAM_ID=123456789
