<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG builds ONLY. This file overrides src/main/.../network_security_config.xml
  for the debug variant. It permits cleartext (HTTP) to ANY host so you can point
  the app at a LAN-IP / localhost dev backend — delivered from the panel over FCM
  (e.g. http://192.168.x.x:3000/api/v1) — without needing HTTPS.

  The RELEASE build keeps the main config, which is HTTPS-only (plus localhost).
  So for production, set an HTTPS server URL in the panel ("آدرس سرور").
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
